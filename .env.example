# 复制成 .env 并填入真实值（.env 已在 .gitignore 中，不会被提交）
# 本地运行：  set -a && source .env && set +a && python main.py

# PushPlus 推送 token（必填）
PUSHPLUS_TOKEN=26614f5b8a874aab9ad4791555079520

# 群组编码，只发给自己就留空
PUSHPLUS_TOPIC=

# 萝卜投研 Cloud-Sso-Token（选填）。
# 不填则该源自动降级为东财"机构盈利预测"，推送里会如实标注。
# 获取方式：登录 robo.datayes.com -> 开发者工具 -> 任一 gw.datayes.com 请求
#           的请求头 Cloud-Sso-Token
DATAYES_TOKEN=

# 覆盖配置（选填）
# OCTOPUS_WINDOW_MINUTES=180
# OCTOPUS_PUSH_WHEN_EMPTY=true
# OCTOPUS_DISABLED_SOURCES=datayes,hibor
